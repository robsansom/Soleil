---
import Base from '../../layouts/Base.astro';
import PageHero from '../site/PageHero.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const p = t.privacyPage;
---

<Base title={p.metaTitle} description={p.metaDescription}>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.headline}
    titleDim={p.headlineDim}
    meta={p.lastUpdated}
    intro={p.intro}
  />

  <section class="scene" data-tone="paper">
    <div class="wrap legal">
      <div class="legal__promises">
        <h2 class="eyebrow">{p.promisesTitle}</h2>
        <ul>
          {p.promises.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <div class="legal__sections">
        {
          p.sections.map((section) => (
            <section>
              <h2 class="display-sm">{section.title}</h2>
              <p>{section.body}</p>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .legal {
    max-width: 58rem;
  }

  .legal__promises {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--r-lg);
    background: var(--sky-pale);
  }

  .legal__promises h2 {
    color: var(--sunset-deep);
    margin-bottom: 1.1rem;
  }

  .legal__promises ul {
    display: grid;
    gap: 0.65rem;
  }

  .legal__promises li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .legal__promises li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--solar-orange);
  }

  .legal__sections {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .legal__sections p {
    margin-top: 0.75rem;
    font-size: 1.0313rem;
    line-height: 1.7;
    max-width: 72ch;
    color: var(--ink-soft);
  }
</style>
