---
/**
 * The one download call to action. While `appStoreUrl` is still a
 * placeholder every instance renders the "coming soon" pill; the moment
 * a real product URL lands in src/config/site.ts they all become links
 * to the App Store.
 */
import { site, appStoreLive } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  /** Visual weight — 'pink' is the primary action colour. */
  variant?: 'pink' | 'ink' | 'paper' | 'solar';
  /** Header/footer use the short label. */
  compact?: boolean;
  class?: string;
}

const { variant = 'pink', compact = false, class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const label = compact ? t.cta.comingSoonShort : t.cta.comingSoon;
const variantClass = variant === 'pink' ? '' : ` btn--${variant}`;
---

{
  appStoreLive ? (
    <a
      class={`btn${variantClass} ${className}`}
      href={site.appStoreUrl}
      aria-label={t.a11y.appStoreLinkLabel}
    >
      <span>{t.a11y.appStoreBadgeAlt}</span>
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  ) : (
    <span class={`cta-pill ${className}`} data-variant={variant}>
      <span class="cta-pill__dot" aria-hidden="true" />
      {label}
    </span>
  )
}

<style>
  .cta-pill[data-variant='solar'],
  .cta-pill[data-variant='paper'] {
    background: var(--paper);
    color: var(--ink);
  }
  .cta-pill[data-variant='solar'] .cta-pill__dot,
  .cta-pill[data-variant='paper'] .cta-pill__dot {
    background: var(--sunset-pink);
  }
</style>
