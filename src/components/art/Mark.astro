---
/**
 * One coherent set of hand-drawn-feeling line marks. Same 120×120 grid,
 * same stroke weight, same round caps — they read as a family rather
 * than as stock icons. ASSET_NEEDED.md asks a designer to replace these
 * with a proper Soleil sticker sheet.
 */
export interface Props {
  name: 'sky' | 'cover' | 'session' | 'realsun' | 'sun' | 'cloud' | 'water' | 'watch';
  size?: number;
  class?: string;
}

const { name, size = 120, class: className = '' } = Astro.props;
const rays = Array.from({ length: 8 }, (_, i) => i * 45);
---

<svg
  class={`mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'sky' && (
      <g>
        <circle cx="46" cy="42" r="17" />
        {rays.map((deg) => (
          <path d="M46 17V9" transform={`rotate(${deg} 46 42)`} />
        ))}
        <path d="M56 96h44a14 14 0 0 0 1-28 20 20 0 0 0-37-9 15 15 0 0 0-8 37Z" />
      </g>
    )
  }
  {
    name === 'cover' && (
      <g>
        <path d="M34 76c0-27 11-40 26-40s26 13 26 40" />
        <ellipse cx="60" cy="78" rx="44" ry="12" />
        <path d="M38 68c14 6 30 6 44 0" />
        <path d="M100 30l8-8M104 44h10" />
      </g>
    )
  }
  {
    name === 'session' && (
      <g>
        <circle cx="60" cy="70" r="32" />
        <path d="M50 28h20M60 28v10M60 70l17-15M88 42l8-8" />
      </g>
    )
  }
  {
    name === 'realsun' && (
      <g>
        <path d="M18 82c10-42 30-60 42-60s32 18 42 60" />
        <path d="M32 100V88M52 100V76M72 100V70M92 100V84" />
      </g>
    )
  }
  {
    name === 'sun' && (
      <g>
        <circle cx="60" cy="60" r="22" />
        {rays.map((deg) => (
          <path d="M60 28V14" transform={`rotate(${deg} 60 60)`} />
        ))}
      </g>
    )
  }
  {
    name === 'cloud' && (
      <g>
        <path d="M38 92h48a17 17 0 0 0 1-34 23 23 0 0 0-43-10 17 17 0 0 0-6 44Z" />
        <path d="M36 34l-8-8M62 22V10M92 34l8-8" />
      </g>
    )
  }
  {
    name === 'water' && (
      <g>
        <path d="M60 18c16 22 26 36 26 48a26 26 0 0 1-52 0c0-12 10-26 26-48Z" />
        <path d="M46 66c0 9 6 15 14 16" />
      </g>
    )
  }
  {
    name === 'watch' && (
      <g>
        <rect x="38" y="34" width="44" height="52" rx="14" />
        <path d="M48 34l3-16h18l3 16M48 86l3 16h18l3-16M60 52v12l9 6" />
      </g>
    )
  }
</svg>

<style>
  .mark {
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
