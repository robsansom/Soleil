---
/** Guides hub — English only (the guides target English search queries). */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import { guides } from '../../data/guides';

const title = 'Sun safety & UV guides | Soleil';
const description =
  'Straight answers to sunny-day questions: what the UV index means, how long people burn in, sunscreen reapply rules, tanning honesty, kids, clouds and Apple Watch daylight.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL('/guides/', Astro.site).toString(),
    hasPart: guides.map((g) => ({
      '@type': 'Article',
      headline: g.title,
      url: new URL(`/guides/${g.slug}`, Astro.site).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
    ],
  },
];
---

<Base title={title} description={description} pathname="/guides/" jsonLd={jsonLd} localised={false}>
  <PageHero
    eyebrow="Sun guides"
    title="The sun,"
    titleDim="explained honestly."
    intro="Every guide answers a real question with the published science first, then shows how Soleil turns the answer into something your phone just handles for you."
  />

  <section class="scene" data-tone="paper">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Guides</span>
      </nav>

      <ul class="guides">
        {
          guides.map((g) => (
            <li>
              <a class="gcard" href={`/guides/${g.slug}`}>
                <span class="eyebrow gcard__cat">{g.category}</span>
                <h2 class="display-sm gcard__title">{g.title}</h2>
                <p class="gcard__body">{g.metaDescription}</p>
                <span class="gcard__more">Read the guide →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-faint);
    margin-bottom: 2.5rem;
  }

  .crumbs a {
    text-underline-offset: 3px;
  }

  .guides {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  .gcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem;
    border-radius: var(--r-lg);
    background: var(--paper-warm);
    text-decoration: none;
    transition: transform 0.35s var(--ease-plop), background-color 0.2s linear;
  }

  .gcard:hover {
    transform: translateY(-4px) rotate(-0.6deg);
    background: var(--solar-pale);
  }

  .gcard__cat {
    color: var(--sunset-deep);
  }

  .gcard__title {
    margin-top: 0.85rem;
  }

  .gcard__body {
    flex: 1;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .gcard__more {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--sunset-deep);
  }
</style>
