---
/**
 * The Sun Window card: live UV index and category as the hero fact, the
 * day's curve beside it, and the plain-language guidance underneath.
 * Never a countdown — the guidance says what to do now.
 */
import { useTranslations } from '../../i18n/utils';

export interface Props {
  /** Show the peak chip overlapping the corner. */
  chip?: boolean;
  /** Hide the guidance line in tight card slots. */
  compact?: boolean;
  class?: string;
}

const { chip = false, compact = false, class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.sunWindow;
---

<div class={`app-ui ${className}`} role="img" aria-label={t.home.sunWindow.imageAlt} data-reveal="up">
  <article class="ui-card sw" aria-hidden="true">
    <header class="ui-head">
      <span class="ui-label sw__label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1.6v3M12 19.4v3M1.6 12h3M19.4 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        {ui.uvNowLabel}
      </span>
      <span class="ui-time">{ui.location} · {ui.time}</span>
    </header>

    <div class="sw__main">
      <div>
        <p class="sw__value">{ui.value}</p>
        <p class="sw__category">{ui.category}</p>
        <span class="ui-pill sw__live">{ui.livePill}</span>
      </div>

      <div class="sw__chart">
        <svg class="ui-curve" viewBox="0 0 150 76" fill="none" preserveAspectRatio="none">
          <path d="M0 72 C 30 66, 46 16, 75 12 C 104 16, 120 66, 150 72 L 150 76 L 0 76 Z" fill="rgb(255 155 47 / 0.22)" data-grow />
          <path d="M0 72 C 30 66, 46 16, 75 12 C 104 16, 120 66, 150 72" stroke="var(--ui-accent)" stroke-width="2.5" stroke-linecap="round" pathLength="1" data-draw />
          <circle cx="96" cy="24" r="5" fill="var(--ui-card)" stroke="var(--ui-ink)" stroke-width="2.5" data-grow />
        </svg>
        <p class="ui-axis">{ui.axis.map((label) => <span>{label}</span>)}</p>
      </div>
    </div>

    {!compact && <p class="sw__guidance">{ui.guidance}</p>}
  </article>

  {
    chip && (
      <aside class="ui-chip sw__peak" aria-hidden="true">
        <span class="ui-dot" />
        <span>
          <span class="ui-label">{ui.peakLabel}</span>
          <span class="sw__peakValue">{ui.peakValue}</span>
        </span>
      </aside>
    )
  }
</div>

<style>
  .sw__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ui-ink-soft);
  }

  .sw__label svg {
    color: var(--ui-accent);
  }

  .sw__main {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    margin-top: 12px;
  }

  .sw__value {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .sw__category {
    margin-top: 2px;
    font-size: 14px;
    font-weight: 650;
    color: var(--ui-ink-soft);
  }

  .sw__live {
    margin-top: 9px;
  }

  .sw__guidance {
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .sw__peak {
    top: -14px;
    right: -10px;
    transform: rotate(2.5deg);
  }

  .sw__peakValue {
    display: block;
    font-size: 13px;
    font-weight: 700;
  }
</style>
