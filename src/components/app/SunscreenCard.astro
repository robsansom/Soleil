---
/**
 * Sunscreen maintenance, which runs on its own clock: two hours at most,
 * sooner after water, sweat or towel-drying. Kept visually separate from
 * elapsed time outside, because reapplying never resets it.
 */
import { useTranslations } from '../../i18n/utils';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.session;
---

<div class={`app-ui ${className}`} role="img" aria-label={ui.reapplyTitle} data-reveal="up">
  <article class="ui-card" aria-hidden="true">
    <header class="ui-head">
      <span class="ui-label ss__title"><span class="ui-dot" />{ui.reapplyTitle}</span>
    </header>

    <div class="ss__clock">
      <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
        <circle cx="60" cy="60" r="50" stroke="var(--ui-hairline)" stroke-width="8" />
        <path d="M60 10a50 50 0 0 1 43.3 75" stroke="var(--ui-accent)" stroke-width="8" stroke-linecap="round" />
        <path d="M60 34v26l16 10" stroke="var(--ui-ink)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p class="ss__max">2h</p>
    </div>

    <p class="ss__body">{ui.reapplyBody}</p>
  </article>
</div>

<style>
  .ss__title {
    display: inline-flex;
    align-items: center;
    gap: 0.4667em;
    color: var(--ui-ink-soft);
  }

  .ss__clock {
    display: flex;
    align-items: center;
    gap: 0.9333em;
    margin-top: 0.9333em;
  }

  .ss__clock svg {
    width: 5.0667em;
    height: 5.0667em;
    flex: none;
  }

  .ss__max {
    font-family: var(--font-display);
    font-size: 2.9333em;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.85;
  }

  .ss__body {
    margin-top: 0.8em;
    padding-top: 0.8em;
    border-top: 1px solid var(--ui-hairline);
    font-size: 0.8333em;
    line-height: 1.45;
    color: var(--ui-ink-soft);
  }
</style>
