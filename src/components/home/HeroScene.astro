---
import SunPathBackdrop from '../art/SunPathBackdrop.astro';
import DeviceFrame from '../art/DeviceFrame.astro';
import Cta from '../site/Cta.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { hero } = t.home;
---

<section class="hero scene" data-tone="solar">
  <SunPathBackdrop />

  <div class="hero__grid wrap wrap--wide">
    <div class="hero__copy">
      <h1 class="display-hero hero__title" data-split>
        {hero.titleLines.map((line) => <span class="hero__line">{line}</span>)}
      </h1>
      <p class="lede hero__body" data-reveal="up">{hero.body}</p>
      <div class="hero__cta" data-reveal="up"><Cta /></div>
    </div>

    <div class="hero__object">
      <div class="hero__device" data-reveal="plop">
        <DeviceFrame
          src="/images/screen-home.png"
          alt={t.home.sunWindow.imageAlt}
          tilt={8}
          priority
        />
      </div>

      <p class="hand hero__note" data-reveal="up">
        <svg viewBox="0 0 90 60" aria-hidden="true" focusable="false">
          <path d="M84 8C60 2 22 10 10 34" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <path d="M8 22l2 14 14-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {hero.note}
      </p>
    </div>
  </div>

  <p class="hero__cue eyebrow" aria-hidden="true">{hero.scrollCue}</p>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 3rem) clamp(3rem, 7vw, 5rem);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
    width: min(100% - (2 * var(--gutter)), 1680px);
  }

  .hero__title {
    display: grid;
  }

  .hero__line {
    display: block;
  }

  .hero__body {
    margin-top: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
    max-width: 34ch;
  }

  .hero__cta {
    margin-top: clamp(1.4rem, 2.5vw, 2rem);
  }

  .hero__object {
    position: relative;
    /* The protagonist runs past the crop rather than sitting politely
       inside a column. */
    margin-inline: auto -12vw;
    width: min(78vw, 460px);
  }

  .hero__note {
    position: absolute;
    left: -2rem;
    bottom: 16%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 13ch;
    transform: rotate(-5deg);
    text-align: left;
  }

  .hero__note svg {
    width: 54px;
    flex: none;
    order: 2;
    transform: rotate(8deg);
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    color: rgb(23 18 14 / 0.55);
    display: none;
  }

  @media (max-width: 799px) {
    .hero__object {
      width: min(74vw, 340px);
      margin-inline: auto -18vw;
      margin-top: -1rem;
    }
    /* No room beside the cropped phone on a small screen, so the note
       sits in the flow, just under the call to action. */
    .hero__object {
      display: flex;
      flex-direction: column;
    }
    .hero__note {
      position: static;
      order: -1;
      /* The object bleeds past the right edge; the note must not. */
      max-width: 58vw;
      margin: 0 0 0.75rem 0.25rem;
      transform: rotate(-2.5deg);
    }
    .hero__note svg {
      order: 0;
      transform: rotate(178deg);
    }
  }

  @media (min-width: 800px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(1rem, 3vw, 3rem);
    }
    .hero__object {
      /* Sized against the viewport height too, so the phone stays a
         cropped object in the composition and never becomes the page. */
      width: min(32vw, 400px, 33svh);
      margin-inline: auto -5vw;
    }
    .hero__note {
      left: -62%;
      bottom: 30%;
      max-width: none;
      width: 56%;
    }
    .hero__cue {
      display: block;
    }
  }

  @media (min-width: 1400px) {
    .hero__object {
      margin-inline: auto -4vw;
    }
  }
</style>
