---
/**
 * The Your Day screen, recreated in HTML.
 *
 * This is the hero's protagonist. It is a recreation rather than a
 * screenshot for one reason above all: a screenshot bakes English into
 * the single image every locale sees. Rebuilt, it localises with the rest
 * of the page, stays crisp at any size, and costs a few kB instead of a
 * 500kB PNG.
 *
 * It is assembled from the same cards as every other recreated surface
 * (./cards/), in the order Your Day stacks them — UV now in cyan, the four
 * condition tiles, then the orange daylight card — on the app's paper
 * ground with its floating tab bar. When Your Day changes, change the
 * cards and this follows.
 *
 * Everything scales from one container-relative size: 1em is the app's
 * 16pt body and the screen is 402pt, 25.125em, wide.
 */
import Glyph from './Glyph.astro';
import UvNowCard from './cards/UvNowCard.astro';
import ConditionTiles from './cards/ConditionTiles.astro';
import DaylightCard from './cards/DaylightCard.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.phoneScreen;
const tabIcons = ['calendar', 'sun', 'person'] as const;
---

<div class="ps" role="img" aria-label={t.home.uvNow.imageAlt}>
  <div class="app-screen ps__inner" aria-hidden="true">
    <div class="ps__status">
      <span>{ui.statusTime}</span>
      <span class="ps__statusIcons">
        <svg class="ps__signal" viewBox="0 0 20 12" fill="currentColor">
          <rect x="0" y="8" width="3" height="4" rx="1" />
          <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
          <rect x="10" y="3" width="3" height="9" rx="1" />
          <rect x="15" y="0" width="3" height="12" rx="1" />
        </svg>
        <svg class="ps__wifi" viewBox="0 0 16 12" fill="currentColor">
          <path d="M8 11.2 6 8.6a3.3 3.3 0 0 1 4 0Z" />
          <path d="M3.4 5.6a7.2 7.2 0 0 1 9.2 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          <path d="M1 3a10.9 10.9 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <span class="ps__battery"><span class="ps__batteryFill"></span></span>
      </span>
    </div>

    {/* Content runs under the pinned tab bar, exactly as it does on a real
        screen, so a longer translation can never push the bar out of the
        frame. */}
    <div class="ps__scroll">
      <div class="ps__bar">
        <span class="ps__round"><Glyph name="search" /></span>
      </div>

      <h3 class="ps__place">{t.appUi.uvNow.location}</h3>
      <p class="ui-hand ps__hand"><Glyph name="sun" />{ui.subtitle}</p>

      <div class="ps__stack">
        <UvNowCard lean={-0.5} />
        <ConditionTiles />
        <DaylightCard tone="orange" lean={0.5} />
      </div>
    </div>

    <div class="ps__tabs">
      <div class="ps__tabbar">
        {
          ui.tabs.map((tab, i) => (
            <span class={`ps__tab ${i === 0 ? 'is-on' : ''}`}>
              <Glyph name={tabIcons[i]} class="ps__tabIcon" />
              <span class="ps__tabLabel">{tab}</span>
            </span>
          ))
        }
      </div>
      <span class="ps__fab"><Glyph name="plus" /></span>
    </div>
  </div>
</div>

<style>
  .ps {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .ps__inner {
    --ui-size: 3.98cqw;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.9em 1em 0;
  }

  .ps__scroll {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* Status bar ------------------------------------------------------- */

  .ps__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.75em;
    font-size: 1.05em;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ps__statusIcons {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }

  .ps__signal {
    width: 1.2em;
  }

  .ps__wifi {
    width: 1em;
  }

  .ps__battery {
    position: relative;
    width: 1.55em;
    height: 0.8em;
    padding: 0.1em;
    border-radius: 0.26em;
    box-shadow: inset 0 0 0 0.09em rgb(23 18 14 / 0.35);
  }

  .ps__batteryFill {
    display: block;
    width: 82%;
    height: 100%;
    border-radius: 0.14em;
    background: #34c759;
  }

  /* Header ----------------------------------------------------------- */

  .ps__bar {
    display: flex;
    justify-content: flex-end;
    margin-top: 1em;
  }

  .ps__round {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(23 18 14 / 0.06),
      0 0.25em 0.8em -0.3em rgb(23 18 14 / 0.3);
  }

  .ps__round :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .ps__place {
    margin-top: 0.3em;
    font-family: var(--font-display);
    font-size: 2.4em;
    font-weight: 800;
    letter-spacing: -0.042em;
    line-height: 0.95;
  }

  .ps__hand {
    margin-top: 0.45em;
    font-size: 1.3em;
  }

  .ps__stack {
    display: grid;
    gap: 1.1em;
    margin-top: 0.9em;
  }

  /* Tab bar ---------------------------------------------------------- */

  /* The bar floats over the content, as it does in the app: the card
     below the fold runs on underneath it and fades out. */
  .ps__tabs {
    position: absolute;
    inset: auto 1em 0;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 2.2em 0 1.25em;
    background: linear-gradient(to bottom, rgb(255 253 247 / 0), rgb(255 253 247 / 0.85) 55%);
  }

  .ps__tabbar {
    display: flex;
    flex: 1;
    gap: 0.1em;
    padding: 0.3em;
    border-radius: var(--r-pill);
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(23 18 14 / 0.06),
      0 0.4em 1.2em -0.4em rgb(23 18 14 / 0.35);
  }

  /* Equal columns, so spacing holds whatever the labels do per locale. */
  .ps__tab {
    display: grid;
    flex: 1;
    min-width: 0;
    justify-items: center;
    gap: 0.25em;
    padding: 0.45em 0.2em 0.4em;
    border-radius: var(--r-pill);
  }

  /* The selected tab sits on its own warm capsule, in the app's vivid
     tab pink (SunkindTheme.tabActive). */
  .ps__tab.is-on {
    background: #f1e9d8;
    color: #d9147e;
  }

  .ps__tab :global(.ps__tabIcon) {
    width: 1.55em;
    height: 1.55em;
  }

  .ps__tabLabel {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.7em;
    font-weight: 600;
    line-height: 1;
  }

  .ps__fab {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.4em;
    height: 3.4em;
    border-radius: 50%;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(23 18 14 / 0.06),
      0 0.4em 1.2em -0.4em rgb(23 18 14 / 0.35);
  }

  .ps__fab :global(svg) {
    width: 1.45em;
    height: 1.45em;
  }
</style>
