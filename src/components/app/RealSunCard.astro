---
/** Real Sun: Apple Watch time in daylight, shown against the day's UV.
 *  Daylight is context, never an allowance. */
import { useTranslations } from '../../i18n/utils';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.realSun;

const bars = [26, 40, 34, 52, 66, 58, 44, 30, 22];
---

<div class={`app-ui ${className}`} role="img" aria-label={t.home.realSun.imageAlt} data-reveal="up">
  <article class="ui-card" aria-hidden="true">
    <header class="ui-head">
      <span class="ui-label">{ui.header}</span>
      <span class="ui-time">{ui.watchChip}</span>
    </header>

    <p class="rs__value">{ui.value}</p>
    <p class="ui-label">{ui.daylightLabel}</p>

    <div class="rs__bars" data-grow>
      {bars.map((h) => <span style={`--h:${h}%`} />)}
    </div>
    <p class="ui-axis">{ui.axis.map((label) => <span>{label}</span>)}</p>
  </article>
</div>

<style>
  .rs__value {
    margin-top: 0.8em;
    font-family: var(--font-display);
    font-size: 2.5333em;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .rs__bars {
    display: flex;
    align-items: flex-end;
    gap: 0.3333em;
    height: 4.2667em;
    margin-top: 0.9333em;
  }

  .rs__bars span {
    flex: 1;
    height: var(--h);
    border-radius: var(--r-pill);
    background: var(--twilight);
  }

  .rs__bars span:nth-child(4),
  .rs__bars span:nth-child(5),
  .rs__bars span:nth-child(6) {
    background: var(--ui-accent);
  }
</style>
