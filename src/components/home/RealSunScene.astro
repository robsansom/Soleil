---
/**
 * Scene 7 — Real Sun. The chart is an editorial illustration of the
 * idea (daylight against the day's UV curve), not a screenshot and not
 * a claim about any particular day. There is no safe-allowance framing
 * here: the bars show when daylight happened, never how much is "left".
 *
 * Server-rendered as three labelled blocks; the script upgrades them
 * into a keyboard-operable tab set.
 */
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { realSun } = t.home;

/** Bars are evenly spaced through the day; height is illustrative. */
const bars = [
  { x: 78, h: 52, zone: 0 },
  { x: 126, h: 74, zone: 0 },
  { x: 174, h: 40, zone: 0 },
  { x: 246, h: 96, zone: 1 },
  { x: 294, h: 128, zone: 1 },
  { x: 342, h: 150, zone: 1 },
  { x: 390, h: 132, zone: 1 },
  { x: 438, h: 104, zone: 1 },
  { x: 510, h: 78, zone: 2 },
  { x: 558, h: 96, zone: 2 },
  { x: 606, h: 58, zone: 2 },
  { x: 654, h: 34, zone: 2 },
];

const zoneBounds = [
  { x: 46, w: 176 },
  { x: 222, w: 268 },
  { x: 490, w: 224 },
];
---

<section class="scene realsun" data-tone="twilight" id="real-sun" data-realsun data-zone="0">
  <div class="wrap realsun__inner">
    <div class="realsun__copy">
      <p class="eyebrow" data-reveal="up">{realSun.eyebrow}</p>
      <h2 class="display-lg realsun__headline" data-reveal="up">
        <span class="realsun__dim">{realSun.headline}</span>
        <span>{realSun.headlineAccent}</span>
      </h2>

      <div class="realsun__tabs" hidden data-tabs role="tablist" aria-label={realSun.tabsLabel}>
        {
          realSun.tabs.map((tab, i) => (
            <button type="button" role="tab" id={`rs-tab-${i}`} aria-controls={`rs-panel-${i}`} data-tab={i}>
              {tab.label}
            </button>
          ))
        }
      </div>

      <div class="realsun__panels">
        {
          realSun.tabs.map((tab, i) => (
            <div class="realsun__panel" id={`rs-panel-${i}`} data-panel={i} aria-labelledby={`rs-tab-${i}`}>
              <h3 class="display-sm">{tab.title}</h3>
              <p>{tab.body}</p>
            </div>
          ))
        }
      </div>

      <p class="realsun__note">{realSun.note}</p>
    </div>

    <figure class="realsun__figure" data-reveal="up">
      <svg viewBox="0 0 760 320" role="img" aria-label={realSun.imageAlt}>
        {
          zoneBounds.map((zone, i) => (
            <rect class="rs-zone" data-zone-rect={i} x={zone.x} y="140" width={zone.w} height="132" rx="16" />
          ))
        }

        <path
          class="rs-area"
          d="M46 266C170 250 250 120 380 78c130 42 210 172 334 188Z"
        />
        <path
          class="rs-curve"
          d="M46 266C170 250 250 120 380 78c130 42 210 172 334 188"
          fill="none"
        />

        {
          bars.map((bar) => (
            <rect
              class="rs-bar"
              data-bar-zone={bar.zone}
              x={bar.x}
              y={266 - bar.h}
              width="20"
              height={bar.h}
              rx="10"
            />
          ))
        }

        <line class="rs-base" x1="40" y1="266" x2="720" y2="266" />
        <circle class="rs-peak" cx="380" cy="78" r="9" />
      </svg>
      <figcaption class="realsun__legend">
        <span class="realsun__key realsun__key--bar"></span>
        <span>{realSun.eyebrow}</span>
        <span class="realsun__key realsun__key--curve"></span>
        <span>UV</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .realsun {
    margin-inline: clamp(0px, 1.4vw, 20px);
    border-radius: var(--r-scene);
    overflow: clip;
  }

  .realsun__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .realsun__copy .eyebrow {
    color: var(--sky-cyan);
    margin-bottom: 0.9rem;
  }

  .realsun__headline {
    display: grid;
    gap: 0.35rem;
    max-width: 20ch;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .realsun__dim {
    color: rgb(255 255 255 / 0.55);
  }

  .realsun__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .realsun__tabs button {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 2px solid rgb(255 255 255 / 0.36);
    border-radius: var(--r-pill);
    background: transparent;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s linear,
      color 0.2s linear;
  }

  .realsun__tabs button[aria-selected='true'] {
    background: var(--sky-cyan);
    border-color: var(--sky-cyan);
    color: var(--ink);
  }

  .realsun__panels {
    display: grid;
    gap: 1.5rem;
    min-height: 6.5rem;
  }

  .realsun__panel p {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    max-width: 42ch;
    color: var(--scene-muted);
  }

  .realsun__note {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--scene-rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 52ch;
    color: rgb(255 255 255 / 0.72);
  }

  /* Chart ------------------------------------------------------------ */

  .realsun__figure svg {
    width: 100%;
    height: auto;
  }

  .rs-zone {
    fill: rgb(255 255 255 / 0.07);
    opacity: 0;
    transition: opacity 0.35s linear;
  }

  .realsun[data-zone='0'] .rs-zone[data-zone-rect='0'],
  .realsun[data-zone='1'] .rs-zone[data-zone-rect='1'],
  .realsun[data-zone='2'] .rs-zone[data-zone-rect='2'] {
    opacity: 1;
  }

  .rs-area {
    fill: rgb(255 216 77 / 0.16);
  }

  .rs-curve {
    stroke: var(--solar-yellow);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .rs-peak {
    fill: var(--solar-orange);
  }

  .rs-base {
    stroke: rgb(255 255 255 / 0.3);
    stroke-width: 2;
  }

  .rs-bar {
    fill: var(--twilight-pale);
    transition:
      fill 0.35s linear,
      opacity 0.35s linear;
    opacity: 0.5;
  }

  .realsun[data-zone='0'] .rs-bar[data-bar-zone='0'],
  .realsun[data-zone='1'] .rs-bar[data-bar-zone='1'],
  .realsun[data-zone='2'] .rs-bar[data-bar-zone='2'] {
    fill: var(--sky-cyan);
    opacity: 1;
  }

  .realsun__legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.7);
  }

  .realsun__key {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--sky-cyan);
  }

  .realsun__key--curve {
    margin-left: 0.75rem;
    height: 4px;
    border-radius: 2px;
    background: var(--solar-yellow);
  }

  @media (min-width: 1000px) {
    .realsun__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }
</style>

<script>
  import { initTabs } from '../../scripts/tabs';
  initTabs();
</script>
