---
/** Scene 6 — the benefit badges settle around the Soleil mark. The
 *  copy is laid out and readable before any movement happens; the
 *  cursor reaction is a garnish on pointer devices only. */
import SunMark from '../site/SunMark.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { why } = t.home;

/** Two loose columns either side of the copy — placed clear of the
 *  centre so nothing ever lands on the text. */
const looks = [
  { x: 5, y: 6, d: 1, tone: 'cyan', tilt: -5 },
  { x: 72, y: 4, d: 0.6, tone: 'pink', tilt: 4 },
  { x: 0, y: 20, d: 0.85, tone: 'solar', tilt: 3 },
  { x: 78, y: 18, d: 1.15, tone: 'violet', tilt: -4 },
  { x: 8, y: 34, d: 0.7, tone: 'orange', tilt: 5 },
  { x: 74, y: 32, d: 1, tone: 'ink', tilt: -3 },
  { x: 1, y: 48, d: 0.55, tone: 'cyan', tilt: 2 },
  { x: 79, y: 46, d: 0.9, tone: 'solar', tilt: -5 },
  { x: 7, y: 62, d: 1.1, tone: 'violet', tilt: 4 },
  { x: 73, y: 60, d: 0.65, tone: 'cyan', tilt: -2 },
  { x: 2, y: 76, d: 0.8, tone: 'pink', tilt: -4 },
  { x: 77, y: 74, d: 1.05, tone: 'orange', tilt: 3 },
  { x: 9, y: 90, d: 0.6, tone: 'ink', tilt: 5 },
  { x: 71, y: 88, d: 0.95, tone: 'solar', tilt: -3 },
];

/** Deterministic scatter: each chip falls a different distance with a
 *  different spin, so the cluster lands like dropped stickers rather than
 *  a row sliding down together. */
const badges = why.badges.map((label, i) => ({
  label,
  ...looks[i % looks.length],
  fall: 200 + ((i * 67) % 190),
  spin: ((i * 53) % 26) - 13,
}));
---

<section class="scene why" data-tone="solar-pale" id="why">
  <div class="wrap why__stage" data-badges>
    <div class="why__centre">
      <span class="why__mark"><SunMark size={120} /></span>
      <p class="eyebrow" data-reveal="up">{why.eyebrow}</p>
      <h2 class="display-lg why__headline" data-reveal="up">{why.headline}</h2>
      <p class="lede why__body" data-reveal="up">{why.body}</p>
      <p class="hand why__note" data-reveal="up">{why.note}</p>
    </div>

    <ul class="why__badges">
      {
        badges.map((badge) => (
          <li
            class={`sticker sticker--${badge.tone} why__badge`}
            style={`--d:${badge.d}; --tilt:${badge.tilt}deg; --fall:${badge.fall}px; --spin:${badge.spin}deg`}
            data-badge
            data-reveal="drop"
          >
            {badge.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    overflow: clip;
  }

  .why__stage {
    position: relative;
  }

  .why__centre {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
  }

  .why__mark {
    display: block;
    width: 120px;
    margin-inline: auto;
    margin-bottom: 1.25rem;
    color: var(--solar-orange);
  }

  .why__centre .eyebrow {
    color: var(--sunset-deep);
    margin-bottom: 0.85rem;
  }

  .why__headline {
    max-width: 14ch;
    margin-inline: auto;
  }

  .why__body {
    margin-top: 1.1rem;
    margin-inline: auto;
  }

  .why__note {
    margin-top: 1.35rem;
    transform: rotate(-1.5deg);
    color: var(--ink-soft);
  }

  /* One centred pile under the copy at every width. The two absolute
     columns were never symmetrical about the text, and the stacked
     arrangement reads as a deliberate cluster rather than a stray edge. */
  .why__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 46rem;
    margin: 2.25rem auto 0;
  }

  .why__badge {
    transform: rotate(var(--tilt)) translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.6s var(--ease-weight);
  }

  @media (min-width: 900px) {
    .why__badges {
      max-width: 60rem;
      gap: 0.65rem;
      margin-top: 3rem;
    }

    .why__badge {
      font-size: 0.9375rem;
      padding: 0.62rem 1.15rem;
    }
  }
</style>

<script>
  import { initBadges } from '../../scripts/badges';
  initBadges();
</script>
