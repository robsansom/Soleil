---
/**
 * Scene 5 — the breadth wall. Oversized phrases carry the whole scene;
 * the imagery around them is decorative enhancement (CSS hover on
 * pointer devices, an in-view rotation on touch) and never carries
 * meaning of its own.
 */
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { moments } = t.home;

/** Real photography and real screenshots only. */
const pool = [
  { src: '/images/photo-sunscreen.jpg', w: 1254, h: 1254 },
  { src: '/images/screen-home.png', w: 1206, h: 2436 },
  { src: '/images/photo-shade.jpg', w: 1254, h: 1254 },
  { src: '/images/screen-family.png', w: 1206, h: 2622 },
  { src: '/images/screen-your-sun.png', w: 1206, h: 2622 },
];

const items = moments.items.map((text, i) => ({
  text,
  a: pool[i % pool.length],
  b: pool[(i + 2) % pool.length],
  tilt: [-6, 5, -4, 7, -5][i % 5],
}));
---

<section class="scene moments" data-tone="pink" id="moments">
  <div class="wrap moments__head">
    <p class="eyebrow" data-reveal="up">{moments.eyebrow}</p>
    <h2 class="display-lg moments__headline" data-reveal="up">{moments.headline}</h2>
  </div>

  <ul class="moments__list" data-moments>
    {
      items.map((item) => (
        <li class="moment" data-moment style={`--tilt:${item.tilt}deg`}>
          <span class="moment__text display-xl">{item.text}</span>
          <span class="moment__art moment__art--a" aria-hidden="true">
            <img src={item.a.src} alt="" width={item.a.w} height={item.a.h} loading="lazy" decoding="async" />
          </span>
          <span class="moment__art moment__art--b" aria-hidden="true">
            <img src={item.b.src} alt="" width={item.b.w} height={item.b.h} loading="lazy" decoding="async" />
          </span>
        </li>
      ))
    }
  </ul>

  <p class="hand moments__closer" data-reveal="up">{moments.closer}</p>
</section>

<style>
  .moments {
    overflow: clip;
    text-align: center;
  }

  .moments__head .eyebrow {
    color: var(--wine);
    margin-bottom: 0.9rem;
  }

  .moments__headline {
    max-width: 18ch;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .moments__list {
    display: grid;
    gap: 0.1em;
  }

  .moment {
    position: relative;
    line-height: 0.88;
  }

  .moment__text {
    display: inline-block;
    padding-inline: 0.1em;
    transition: transform 0.5s var(--ease-plop);
  }

  .moment__art {
    position: absolute;
    top: 50%;
    display: block;
    width: clamp(96px, 11vw, 168px);
    border-radius: var(--r-md);
    overflow: clip;
    box-shadow: var(--lift-md);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) rotate(var(--tilt)) scale(0.9);
    transition:
      opacity 0.32s linear,
      transform 0.5s var(--ease-plop);
  }

  .moment__art img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .moment__art--a {
    left: max(2vw, calc(50% - 34vw));
  }

  .moment__art--b {
    right: max(2vw, calc(50% - 34vw));
    --tilt: calc(var(--tilt) * -1);
  }

  .moment.is-active .moment__art,
  .moment:hover .moment__art {
    opacity: 1;
    transform: translateY(-50%) rotate(var(--tilt)) scale(1);
  }

  .moment:hover .moment__text {
    transform: scale(1.03);
  }

  .moments__closer {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    transform: rotate(-2deg);
  }

  /* Phrases already reach the edges on small screens; the clusters would
     collide with them, so they only appear from tablet up. */
  @media (max-width: 719px) {
    .moment__art {
      display: none;
    }
  }
</style>

<script>
  import { initMoments } from '../../scripts/moments';
  initMoments();
</script>
