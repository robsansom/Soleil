---
/**
 * The handful of small glyphs the app draws inside stickers, rows and the
 * tab bar — stand-ins for the SF Symbols it uses, drawn once so every
 * recreated surface uses the same shapes.
 */
type GlyphName = 'sun' | 'shield' | 'bell' | 'timer' | 'people' | 'watch' | 'live' | 'drop' | 'calendar' | 'person' | 'search' | 'plus' | 'chevron' | 'arrow' | 'cloud' | 'wind';

export interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const rays =
  'M12 1.6v3M12 19.4v3M1.6 12h3M19.4 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1';
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === 'sun' && (
      <g fill="currentColor">
        <circle cx="12" cy="12" r="5" />
        <path d={rays} stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    name === 'shield' && (
      <g>
        <circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="2.4" />
        <path d="M12 3.4a8.6 8.6 0 0 1 0 17.2Z" fill="currentColor" />
      </g>
    )
  }
  {
    name === 'bell' && (
      <path
        d="M12 2.8a6 6 0 0 0-6 6v3.6L4.2 16a.9.9 0 0 0 .8 1.3h14a.9.9 0 0 0 .8-1.3L18 12.4V8.8a6 6 0 0 0-6-6Zm-2.6 16a2.6 2.6 0 0 0 5.2 0Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'timer' && (
      <g fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round">
        <circle cx="12" cy="13.4" r="7.8" />
        <path d="M12 9.2v4.4l2.6 1.6M9.4 2.6h5.2" />
      </g>
    )
  }
  {
    name === 'people' && (
      <g fill="currentColor">
        <circle cx="8.6" cy="8" r="3.6" />
        <circle cx="16.6" cy="9" r="2.9" />
        <path d="M1.8 19.6c0-3.7 3-6 6.8-6s6.8 2.3 6.8 6Z" />
        <path d="M16.2 19.6h6c0-3-2.2-5-5.4-5-1 0-1.9.2-2.6.6 1.2 1.1 2 2.6 2 4.4Z" />
      </g>
    )
  }
  {
    name === 'watch' && (
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
        <rect x="6" y="6" width="12" height="12" rx="3.6" />
        <path d="M8.6 6 9.4 2h5.2l.8 4M8.6 18l.8 4h5.2l.8-4" />
      </g>
    )
  }
  {
    name === 'live' && (
      <g fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round">
        <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
        <path d="M7.4 7.4a6.5 6.5 0 0 0 0 9.2M16.6 7.4a6.5 6.5 0 0 1 0 9.2M4.2 4.2a11 11 0 0 0 0 15.6M19.8 4.2a11 11 0 0 1 0 15.6" />
      </g>
    )
  }
  {
    name === 'drop' && (
      <path d="M12 2.6s-6.6 7.3-6.6 11.9a6.6 6.6 0 0 0 13.2 0C18.6 9.9 12 2.6 12 2.6Z" fill="currentColor" />
    )
  }
  {
    name === 'calendar' && (
      <g>
        <rect x="2.6" y="3.8" width="18.8" height="17.4" rx="4.6" fill="currentColor" />
        {[0, 1, 2].map((row) =>
          [0, 1, 2].map((col) => (
            <rect x={6.4 + col * 4.3} y={9.4 + row * 3.5} width="2.4" height="2.2" rx="0.7" fill="var(--paper)" />
          )),
        )}
      </g>
    )
  }
  {
    name === 'person' && (
      <g fill="currentColor">
        <circle cx="12" cy="7.4" r="4.5" />
        <path d="M3.1 21.6c0-4.9 4-7.8 8.9-7.8s8.9 2.9 8.9 7.8Z" />
      </g>
    )
  }
  {
    name === 'search' && (
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5 21 21" />
      </g>
    )
  }
  {
    name === 'plus' && (
      <path d="M12 4.6v14.8M4.6 12h14.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
    )
  }
  {
    name === 'chevron' && (
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
  {
    name === 'arrow' && (
      <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
  {
    name === 'cloud' && (
      <path d="M7.2 19a4.7 4.7 0 0 1-.6-9.4 6 6 0 0 1 11.4 1.6A3.9 3.9 0 0 1 17.6 19Z" fill="currentColor" />
    )
  }
  {
    name === 'wind' && (
      <path d="M3 9h11.5a3 3 0 1 0-3-3M3 13.5h15.5a3 3 0 1 1-3 3M3 18h6" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
    )
  }
</svg>
