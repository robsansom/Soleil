---
/** Scene 6 — the benefit badges settle around the Soleil mark. The
 *  copy is laid out and readable before any movement happens; the
 *  cursor reaction is a garnish on pointer devices only. */
import SunMark from '../site/SunMark.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { why } = t.home;

/** Placed clear of the centre column so nothing ever sits on the copy. */
const looks = [
  { x: 7, y: 14, d: 1, tone: 'cyan', tilt: -5 },
  { x: 73, y: 9, d: 0.6, tone: 'pink', tilt: 4 },
  { x: 1, y: 46, d: 0.85, tone: 'solar', tilt: 3 },
  { x: 78, y: 40, d: 1.15, tone: 'violet', tilt: -4 },
  { x: 8, y: 78, d: 0.7, tone: 'orange', tilt: 5 },
  { x: 70, y: 72, d: 1, tone: 'ink', tilt: -3 },
  { x: 76, y: 90, d: 0.5, tone: 'cyan', tilt: 2 },
];

const badges = why.badges.map((label, i) => ({ label, ...looks[i % looks.length] }));
---

<section class="scene why" data-tone="solar-pale" id="why">
  <div class="wrap why__stage" data-badges>
    <div class="why__centre">
      <SunMark size={120} class="why__mark" />
      <p class="eyebrow" data-reveal="up">{why.eyebrow}</p>
      <h2 class="display-lg why__headline" data-reveal="up">{why.headline}</h2>
      <p class="lede why__body" data-reveal="up">{why.body}</p>
      <p class="hand why__note" data-reveal="up">{why.note}</p>
    </div>

    <ul class="why__badges">
      {
        badges.map((badge) => (
          <li
            class={`sticker sticker--${badge.tone} why__badge`}
            style={`--x:${badge.x}%; --y:${badge.y}%; --d:${badge.d}; --tilt:${badge.tilt}deg`}
            data-badge
            data-reveal="sticker"
          >
            {badge.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    overflow: clip;
  }

  .why__stage {
    position: relative;
  }

  .why__centre {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
  }

  .why__mark {
    margin-inline: auto;
    margin-bottom: 1.25rem;
    color: var(--solar-orange);
  }

  .why__centre .eyebrow {
    color: var(--sunset-deep);
    margin-bottom: 0.85rem;
  }

  .why__headline {
    max-width: 14ch;
    margin-inline: auto;
  }

  .why__body {
    margin-top: 1.1rem;
    margin-inline: auto;
  }

  .why__note {
    margin-top: 1.35rem;
    transform: rotate(-1.5deg);
    color: var(--ink-soft);
  }

  .why__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.25rem;
  }

  .why__badge {
    transform: rotate(var(--tilt)) translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.6s var(--ease-weight);
  }

  @media (min-width: 1000px) {
    .why__stage {
      min-height: 34rem;
      display: grid;
      place-items: center;
    }

    .why__badges {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
      pointer-events: none;
    }

    .why__badge {
      position: absolute;
      left: var(--x);
      top: var(--y);
      font-size: 0.9375rem;
      padding: 0.6rem 1.1rem;
    }
  }
</style>

<script>
  import { initBadges } from '../../scripts/badges';
  initBadges();
</script>
