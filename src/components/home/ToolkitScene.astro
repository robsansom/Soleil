---
/**
 * The feature rail. Native CSS scroll-snap does the heavy lifting: real
 * touch drag, real keyboard scrolling, real momentum, and it works with
 * no JavaScript at all. The script only adds the arrow buttons' behaviour
 * and the slight rotation each card takes as it passes the centre.
 */
import DeviceFrame from '../art/DeviceFrame.astro';
import Mark from '../art/Mark.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { toolkit } = t.home;

/** Visual treatment per card, in the order the copy declares them. */
const looks = [
  { tone: 'cyan', tilt: -1.4, shot: '/images/screen-home.png' },
  { tone: 'solar', tilt: 1.1, mark: 'cover' as const },
  { tone: 'pink', tilt: -1, mark: 'session' as const, big: '2h' },
  { tone: 'orange', tilt: 1.5, shot: '/images/screen-your-sun.png' },
  { tone: 'violet', tilt: -1.2, shot: '/images/screen-family.png' },
  { tone: 'twilight', tilt: 1.2, mark: 'realsun' as const },
];

const cards = toolkit.cards.map((card, i) => ({ ...card, ...looks[i] }));
---

<section class="scene toolkit" data-tone="paper" id="toolkit">
  <div class="wrap toolkit__head">
    <div>
      <p class="eyebrow" data-reveal="up">{toolkit.eyebrow}</p>
      <h2 class="display-xl" data-reveal="up">{toolkit.headline}</h2>
    </div>
    <div class="toolkit__arrows">
      <button type="button" class="rail-btn" data-rail-prev aria-label={toolkit.prev}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="rail-btn" data-rail-next aria-label={toolkit.next}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>

  <div
    class="rail"
    data-rail
    tabindex="0"
    role="group"
    aria-label={toolkit.railLabel}
  >
    <ul class="rail__track">
      {
        cards.map((card) => (
          <li class="tcard" data-tone={card.tone} style={`--tilt:${card.tilt}deg`} data-rail-item>
            <div class="tcard__inner">
              <span class="sticker tcard__tag">{card.tag}</span>
              <h3 class="display-md tcard__title">{card.title}</h3>
              <p class="tcard__body">{card.body}</p>
              <div class={`tcard__figure ${card.shot ? '' : 'tcard__figure--graphic'}`}>
                {card.shot ? (
                  <DeviceFrame src={card.shot} alt="" tilt={-2} crop class="tcard__shot" />
                ) : (
                  <div class="tcard__graphic">
                    {card.big && <span class="tcard__big">{card.big}</span>}
                    <Mark name={card.mark!} size={140} />
                  </div>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .toolkit {
    overflow: clip;
  }

  .toolkit__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .toolkit__head .eyebrow {
    color: var(--sunset-deep);
    margin-bottom: 0.9rem;
  }

  .toolkit__head h2 {
    max-width: 16ch;
  }

  .toolkit__arrows {
    display: none;
    gap: 0.5rem;
    flex: none;
    padding-bottom: 0.5rem;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: transform 0.3s var(--ease-plop), opacity 0.2s linear;
  }

  .rail-btn svg {
    width: 20px;
    height: 20px;
  }

  .rail-btn:hover {
    transform: scale(1.08);
  }

  .rail-btn[disabled] {
    opacity: 0.28;
    cursor: default;
    transform: none;
  }

  .rail {
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* The rail bleeds to both edges; cards peek in from off-screen. */
    padding-inline: max(var(--gutter), calc((100vw - var(--max-w)) / 2));
    padding-block: 1.5rem 2.5rem;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail__track {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    width: max-content;
  }

  .tcard {
    scroll-snap-align: center;
    width: min(78vw, 360px);
    flex: none;
    transform: rotate(var(--tilt)) translateY(var(--drift, 0px));
    transition: transform 0.5s var(--ease-weight);
  }

  .tcard__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 460px;
    padding: 1.5rem 1.5rem 0;
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--paper));
    color: var(--card-fg, var(--ink));
    box-shadow: var(--lift-md);
    overflow: clip;
  }

  .tcard[data-tone='cyan'] .tcard__inner {
    --card-bg: var(--sky-cyan);
  }
  .tcard[data-tone='solar'] .tcard__inner {
    --card-bg: var(--solar-yellow);
  }
  .tcard[data-tone='pink'] .tcard__inner {
    --card-bg: var(--sunset-pink);
  }
  .tcard[data-tone='orange'] .tcard__inner {
    --card-bg: var(--solar-orange);
  }
  .tcard[data-tone='violet'] .tcard__inner {
    --card-bg: var(--twilight-pale);
  }
  .tcard[data-tone='twilight'] .tcard__inner {
    --card-bg: var(--twilight-deep);
    --card-fg: #fff;
  }

  .tcard__tag {
    align-self: flex-start;
    background: var(--paper);
    color: var(--ink);
    transform: rotate(-2deg);
  }

  .tcard__title {
    margin-top: 1.1rem;
  }

  .tcard__body {
    margin-top: 0.7rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .tcard__figure {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .tcard__shot {
    width: 62%;
    margin-bottom: -14%;
  }

  .tcard__figure--graphic {
    margin-top: 0;
    flex: 1;
    align-items: center;
    padding-block: 1rem 2.5rem;
  }

  .tcard__graphic {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: rotate(-3deg);
  }

  .tcard__big {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.8;
  }

  @media (min-width: 900px) {
    .toolkit__arrows {
      display: flex;
    }
    .tcard {
      width: 380px;
    }
  }
</style>

<script>
  import { initRail } from '../../scripts/rail';
  initRail();
</script>
