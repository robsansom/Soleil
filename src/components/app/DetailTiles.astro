---
/** The numbers behind the Sun Window: peak, level, cloud cover,
 *  humidity — the 2×2 tiles from the app's Your Day screen. */
import { useTranslations } from '../../i18n/utils';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.sunWindow;
---

<div class={`app-ui ${className}`} role="img" aria-label={t.home.sunWindow.imageAlt} data-reveal="up">
  <article class="ui-card" aria-hidden="true">
    <header class="ui-head">
      <span class="ui-label">{ui.conditions}</span>
      <span class="ui-time">{ui.time}</span>
    </header>
    <div class="ui-tiles tiles">
      {
        ui.tiles.map((tile) => (
          <div class="ui-tile">
            <p class="ui-label">{tile.label}</p>
            <p class="ui-tile__value">
              {tile.value}
              {tile.caption && <span class="ui-tile__caption">{tile.caption}</span>}
            </p>
          </div>
        ))
      }
    </div>
  </article>
</div>

<style>
  .tiles {
    margin-top: 12px;
  }
</style>
