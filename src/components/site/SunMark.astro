---
/** The Soleil mark: a sun with hand-cut rays. Currency inherits, so it
 *  works on every scene tone. */
export interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = '' } = Astro.props;
const rays = Array.from({ length: 8 }, (_, i) => i * 45);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="20" cy="20" r="8.6" fill="currentColor" />
  {
    rays.map((deg, i) => (
      <rect
        x="19"
        y={i % 2 === 0 ? 1.4 : 2.8}
        width="2"
        height={i % 2 === 0 ? 6.4 : 5}
        rx="1"
        fill="currentColor"
        transform={`rotate(${deg} 20 20)`}
      />
    ))
  }
</svg>
