---
/** The family glance: who is outside and what cover each person has,
 *  with its own reapply reminder rather than a shared one. */
import { useTranslations } from '../../i18n/utils';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const ui = t.appUi.session;
const reapply = t.appUi.session;
---

<div class={`app-ui ${className}`} role="img" aria-label={ui.peopleLabel} data-reveal="up">
  <article class="ui-card" aria-hidden="true">
    <header class="ui-head">
      <span class="ui-label">{ui.peopleLabel}</span>
      <span class="ui-time">{ui.uvChip}</span>
    </header>

    <ul class="fa__people">
      {
        ui.people.map((person) => (
          <li class="ui-person">
            <span class="ui-avatar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4.5 20.5c0-4.1 3.4-6.5 7.5-6.5s7.5 2.4 7.5 6.5Z" />
              </svg>
            </span>
            <span class="ui-person__name">{person.name}</span>
            <span class="ui-person__status">{person.status}</span>
          </li>
        ))
      }
    </ul>

    <div class="fa__note">
      <p class="fa__noteTitle">{reapply.reapplyTitle}</p>
      <p class="fa__noteBody">{reapply.reapplyBody}</p>
    </div>
  </article>
</div>

<style>
  .fa__people {
    margin-top: 10px;
  }

  .fa__note {
    margin-top: 12px;
    padding: 11px 12px;
    border-radius: var(--r-sm);
    background: var(--ui-card-2);
  }

  .fa__noteTitle {
    font-size: 12.5px;
    font-weight: 700;
  }

  .fa__noteBody {
    margin-top: 2px;
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--ui-ink-soft);
  }
</style>
