---
/** Hero backdrop: flat vector sun-path shapes, drawn for this site.
 *  Deliberately organic, deliberately few colours — this is the stage
 *  the device object stands on, not decoration for its own sake. */
---

<svg
  class="sunpath"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g data-reveal="art">
    <path
      class="sunpath__pale"
      d="M980 -60c210 60 276 220 246 344-30 126-206 168-318 258-104 84-124 224-266 276-142 52-306 0-346-114-42-122 84-182 176-252 122-92 172-232 294-352 72-72 138-186 214-160Z"
    />
    <path
      class="sunpath__pale2"
      d="M-140 240c130-96 300-40 372 62 74 104 24 236-72 306-96 70-244 66-330-24-86-90-100-248 30-344Z"
    />
    <path
      class="sunpath__dune"
      d="M0 762c220-62 330 68 520 58 176-10 296-122 486-116 190 6 292 84 434 36V900H0Z"
    />
    <path
      class="sunpath__arc"
      d="M-60 726C286 358 692 130 1124 196"
      fill="none"
      stroke-linecap="round"
    />
    <circle class="sunpath__sun" cx="1124" cy="196" r="52" />
  </g>
</svg>

<style>
  .sunpath {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .sunpath__pale,
  .sunpath__pale2 {
    fill: var(--solar-pale);
  }

  .sunpath__pale2 {
    opacity: 0.7;
  }

  .sunpath__dune {
    fill: var(--solar-orange);
    opacity: 0.92;
  }

  .sunpath__arc {
    stroke: var(--solar-deep);
    stroke-width: 9;
    stroke-dasharray: 2 26;
    opacity: 0.85;
  }

  .sunpath__sun {
    fill: var(--solar-orange);
  }
</style>
