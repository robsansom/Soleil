---
import Base from '../../layouts/Base.astro';
import PageHero from '../site/PageHero.astro';
import { site } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const p = t.supportPage;
---

<Base title={p.metaTitle} description={p.metaDescription}>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.headline}
    titleDim={p.headlineDim}
    intro={p.intro}
  />

  <section class="scene" data-tone="paper">
    <div class="wrap support">
      <div class="support__contact">
        <div>
          <p class="eyebrow">{p.contactTitle}</p>
          <a class="support__email" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        </div>
        <a class="btn" href={`mailto:${site.supportEmail}`}>
          <span>{p.contactButton}</span>
          <span class="btn__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </div>

      <h2 class="display-lg support__faqTitle">{p.faqTitle}</h2>
      <ul class="support__faqs">
        {
          p.faqs.map((faq) => (
            <li>
              <h3 class="display-sm">{faq.q}</h3>
              <p>{faq.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .support {
    max-width: 62rem;
  }

  .support__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--sky-pale);
  }

  .support__contact .eyebrow {
    color: var(--sunset-deep);
    margin-bottom: 0.6rem;
  }

  .support__email {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-underline-offset: 5px;
  }

  .support__faqTitle {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .support__faqs {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .support__faqs li {
    padding-top: 1.5rem;
    border-top: 1px solid rgb(23 18 14 / 0.12);
  }

  .support__faqs p {
    margin-top: 0.6rem;
    font-size: 1.0313rem;
    line-height: 1.65;
    max-width: 70ch;
    color: var(--ink-soft);
  }
</style>
