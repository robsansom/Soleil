---
/**
 * Scene 4 — the signature sequence. On a wide screen with motion
 * enabled the stage pins and the four states advance as you scroll; the
 * scroll distance is bounded and never hijacked. Everywhere else the
 * same content is a plain, readable list beside the device.
 */
import DeviceFrame from '../art/DeviceFrame.astro';
import Cta from '../site/Cta.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const { sunWindow } = t.home;
---

<section class="scene sunwin" data-tone="sky-deep" id="sun-window" data-sequence>
  <div class="sunwin__stage">
    <div class="wrap sunwin__inner">
      <div class="sunwin__copy">
        <p class="eyebrow" data-reveal="up">{sunWindow.eyebrow}</p>
        <h2 class="display-lg sunwin__headline" data-reveal="up">{sunWindow.headline}</h2>

        <ol class="sunwin__steps">
          {
            sunWindow.steps.map((step, i) => (
              <li class="swstep" data-step={i}>
                <span class="sticker swstep__label">{step.label}</span>
                <h3 class="display-sm swstep__title">{step.title}</h3>
                <p class="swstep__body">{step.body}</p>
              </li>
            ))
          }
        </ol>

        <ol class="sunwin__dots" aria-hidden="true">
          {sunWindow.steps.map((_, i) => <li data-dot={i} class={i === 0 ? 'is-on' : ''} />)}
        </ol>

        <div class="sunwin__cta" data-reveal="up"><Cta variant="ink" /></div>
      </div>

      <div class="sunwin__device">
        <div class="sunwin__deviceInner" data-sequence-object>
          <DeviceFrame src="/images/screen-home.png" alt={sunWindow.imageAlt} tilt={-4} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sunwin {
    margin-inline: clamp(0px, 1.4vw, 20px);
    border-radius: var(--r-scene);
    padding: 0;
    overflow: clip;
  }

  .sunwin__stage {
    padding-block: var(--scene-pad-y);
  }

  .sunwin__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .sunwin__copy .eyebrow {
    color: var(--sunset-deep);
    margin-bottom: 0.9rem;
  }

  .sunwin__headline {
    max-width: 12ch;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .sunwin__steps {
    display: grid;
    gap: 1.6rem;
    max-width: 46ch;
  }

  .swstep__label {
    background: var(--ink);
    color: var(--paper);
    transform: rotate(-1.5deg);
  }

  .swstep__title {
    margin-top: 0.8rem;
  }

  .swstep__body {
    margin-top: 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 40ch;
  }

  .sunwin__cta {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .sunwin__device {
    position: relative;
    justify-self: center;
    width: min(70vw, 320px);
  }

  .sunwin__dots {
    display: none;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .sunwin__dots li {
    width: 30px;
    height: 5px;
    border-radius: var(--r-pill);
    background: rgb(23 18 14 / 0.22);
    transition: background-color 0.3s linear;
  }

  .sunwin__dots li.is-on {
    background: var(--ink);
  }

  @media (min-width: 1000px) {
    .sunwin__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }
    .sunwin__device {
      /* Bounded by height as well: the object is scaled up to 1.34 by
         the sequence and must still read as a cropped object, not a wall. */
      width: min(30vw, 360px, 31svh);
    }
  }

  /* Pinned sequence — only when JS is running and motion is welcome. */
  @media (min-width: 1000px) {
    :global(html.motion-on) .sunwin {
      height: 300vh;
    }

    :global(html.motion-on) .sunwin__stage {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      height: 100svh;
      padding-block: calc(var(--header-h) + 2rem) 2rem;
    }

    :global(html.motion-on) .sunwin__steps {
      position: relative;
      min-height: 15rem;
      display: block;
    }

    :global(html.motion-on) .swstep {
      position: absolute;
      inset: 0 auto auto 0;
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 0.4s linear,
        transform 0.5s var(--ease-weight);
    }

    :global(html.motion-on) .swstep.is-on {
      opacity: 1;
      transform: none;
    }

    :global(html.motion-on) .sunwin__dots {
      display: flex;
    }
  }
</style>
